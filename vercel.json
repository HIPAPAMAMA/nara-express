{
  "installCommand": "npm install --prefix functions && npm install --prefix web",
  "buildCommand": "npm run build --prefix web",
  "outputDirectory": "web/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" }
  ],
  "crons": [
    { "path": "/api/cron/run-alerts", "schedule": "0 0 * * *" }
  ]
}
